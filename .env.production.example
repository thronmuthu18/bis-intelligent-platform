# ─────────────────────────────────────────────────────────────────────────────
#  BIS Intelligent Platform — Production Environment Template
# ─────────────────────────────────────────────────────────────────────────────
#  DO NOT COMMIT THIS FILE WITH REAL SECRETS.
#  In production, inject these variables via your cloud host / secret manager
#  (e.g., AWS Secrets Manager, Doppler, Render/Vercel dashboard, or /etc/environment).
# ─────────────────────────────────────────────────────────────────────────────

# ── Application Runtime ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Database (Production Managed PostgreSQL with TLS) ────────────────────────
# Must enforce SSL: sslmode=require
DATABASE_URL=postgresql://bis_prod_user:CHANGE_ME_STRONG_DB_PASSWORD@prod-postgres-host.internal:5432/bis_compliance_prod?schema=public&sslmode=require

# ── Domains & CORS ───────────────────────────────────────────────────────────
# Must match your registered production domains
FRONTEND_URL=https://bis.example.com
API_BASE_URL=https://api.bis.example.com/api/v1

# ── Authentication & Security ────────────────────────────────────────────────
# Must be a cryptographically random string (min 64 chars)
# Generate with: openssl rand -base64 64
# NEVER use development default tokens in production.
JWT_SECRET=CHANGE_ME_REPLACE_WITH_A_SECURE_RANDOMLY_GENERATED_64_CHARACTER_SECRET_TOKEN
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Rate Limiting (Production Hardened) ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Structured Production Logging ────────────────────────────────────────────
# Outputs machine-parsable JSON for Datadog / CloudWatch / Loki
LOG_LEVEL=info

# ── S3-Compatible Object Storage (Private Cloud Bucket) ───────────────────────
STORAGE_PROVIDER=s3
STORAGE_BUCKET=bis-compliance-documents-prod
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=CHANGE_ME_AWS_OR_R2_ACCESS_KEY
STORAGE_SECRET_KEY=CHANGE_ME_AWS_OR_R2_SECRET_KEY
# Optional custom S3 endpoint for Cloudflare R2, MinIO, or LocalStack
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_FORCE_PATH_STYLE=false

# ── AI Embeddings & Vector RAG ───────────────────────────────────────────────
# Default: mock (deterministic offline) | Real: openai | gemini
AI_PROVIDER=mock
AI_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-proj-CHANGE_ME_IF_USING_OPENAI_EMBEDDINGS
# GEMINI_API_KEY=AIzaSy_CHANGE_ME_IF_USING_GEMINI_EMBEDDINGS

# ── Multilingual Translation Intelligence (Phase 12) ─────────────────────────
# Default: mock | Real: openai
TRANSLATION_PROVIDER=mock
# OPENAI_API_KEY=sk-proj-CHANGE_ME_IF_USING_OPENAI_TRANSLATION

# ── Consumer Verification Gateway (Phase 11) ─────────────────────────────────
# Default: mock (for demo/eval) | official (queries authoritative DB records)
VERIFICATION_PROVIDER=mock
HALLMARKING_SOURCE_FRESHNESS_DAYS=90
# External gateway endpoints (kept blank if official NIC gateway credentials are not yet peered)
# BIS_OFFICIAL_GATEWAY_URL=
# BIS_HUID_GATEWAY_URL=

# ── Frontend Configuration (For apps/web build time ONLY) ───────────────────
# Injected into Vite at static bundle build time:
# VITE_API_BASE_URL=https://api.bis.example.com/api/v1
# WARNING: NEVER prefix any server secrets with VITE_
