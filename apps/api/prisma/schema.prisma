model HallmarkingCentre {
  id               String         @id @default(uuid()) @db.Uuid
  name             String
  code             String         @unique
  address          String         @db.Text
  city             String
  state            String
  pincode          String
  phone            String?
  email            String?
  website          String?
  latitude         Float?
  longitude        Float?
  status           String         @default("ACTIVE")
  sourceDocumentId String?        @db.Uuid
  sourceUrl        String?
  authorityLevel   AuthorityLevel @default(AUTHORITATIVE)
  isVerified       Boolean        @default(true)
  lastVerifiedAt   DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  sourceDocument   SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([state])
  @@index([city])
  @@index([pincode])
  @@index([code])
  @@index([status])
  @@map("hallmarking_centres")
}

model HallmarkVerification {
  id                        String         @id @default(uuid()) @db.Uuid
  userId                    String?        @db.Uuid
  huid                      String
  enteredDetails            Json?          @default("{}")
  verificationStatus        String         @default("UNKNOWN")
  articleType               String?
  purityPpm                 Int?
  purityKarat               String?
  hallmarkingCentreName     String?
  hallmarkingCentreCode     String?
  hallmarkingDate           DateTime?
  jewellerName              String?
  jewellerRegistrationNumber String?
  sourceDocumentId          String?        @db.Uuid
  sourceUrl                 String?
  sourceAuthority           String?        @default("Bureau of Indian Standards (BIS)")
  retrievedAt               DateTime       @default(now())
  evidence                  Json?          @default("{}")
  createdAt                 DateTime       @default(now())

  user                      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  sourceDocument            SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([huid])
  @@index([verificationStatus])
  @@map("hallmark_verifications")
}

model ConsumerService {
  id                  String         @id @default(uuid()) @db.Uuid
  serviceType         String         @unique
  title               String
  description         String         @db.Text
  eligibility         String?        @db.Text
  requiredInformation Json?          @default("[]")
  officialUrl         String?
  sourceDocumentId    String?        @db.Uuid
  sourceAuthority     String         @default("Bureau of Indian Standards (BIS)")
  status              String         @default("ACTIVE")
  lastVerifiedAt      DateTime       @default(now())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  sourceDocument      SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([serviceType])
  @@map("consumer_services")
}

model ConsumerVerification {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  verificationType String
  query            Json
  resultStatus     String
  source           String?
  evidence         Json?    @default("{}")
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([verificationType])
  @@index([resultStatus])
  @@map("consumer_verifications")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Phase 12 — Multilingual & Accessibility Intelligence Models
// ─────────────────────────────────────────────────────────────────────────────

model UserPreference {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  language      String   @default("en")
  theme         String?  @default("system")
  reducedMotion Boolean  @default(false)
  highContrast  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model TranslationCache {
  id              String   @id @default(uuid()) @db.Uuid
  sourceLanguage  String   @default("en")
  targetLanguage  String
  sourceTextHash  String
  sourceText      String   @db.Text
  translatedText  String   @db.Text
  preservedTerms  String[] @default([])
  sourceReference String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sourceTextHash, targetLanguage])
  @@index([sourceTextHash])
  @@index([targetLanguage])
  @@map("translation_cache")
}
