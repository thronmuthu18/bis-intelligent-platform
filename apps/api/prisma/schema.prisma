  description      String?                     @db.Text
  mandatoryStatus  MandatoryStatus             @default(MANDATORY)
  priority         RequirementPriority         @default(HIGH)
  status           ComplianceRequirementStatus @default(NOT_STARTED)
  evidenceRequired Boolean                     @default(true)
  sourceDocumentId String?                     @db.Uuid
  sourceUrl        String?
  sourceAuthority  AuthorityLevel              @default(AUTHORITATIVE)
  evidence         Json?
  waivedReason     String?                     @db.Text
  waivedByUserId   String?                     @db.Uuid
  waivedAt         DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  journey          ComplianceJourney                 @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  standard         Standard?                         @relation(fields: [standardId], references: [id], onDelete: SetNull)
  sourceDocument   SourceDocument?                   @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
