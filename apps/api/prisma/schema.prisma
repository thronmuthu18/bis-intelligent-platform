  requirementId    String?              @db.Uuid
  title            String
  description      String?              @db.Text
  taskType         ComplianceTaskType   @default(OTHER)
  status           ComplianceTaskStatus @default(TODO)
  priority         RequirementPriority  @default(HIGH)
  assignedToUserId String?              @db.Uuid
  dueDate          DateTime?
  completedAt      DateTime?
  blockerReason    String?              @db.Text
  sourceEvidence   Json?
  taskOrder        Int                  @default(1)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  journey          ComplianceJourney      @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  requirement      ComplianceRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  assignedToUser   User?                  @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([journeyId])
  @@index([requirementId])
  @@index([status])
  @@index([taskType])
  @@index([assignedToUserId])
  @@map("compliance_tasks")
}

model ComplianceAutomationRun {
  id              String            @id @default(uuid()) @db.Uuid
  journeyId       String            @db.Uuid
  runType         AutomationRunType @default(INITIALIZE)
  inputHash       String
  engineVersion   String            @default("1.0.0")
  status          String            @default("COMPLETED")
  changesDetected Json?
  executionTimeMs Int?
  createdAt       DateTime          @default(now())
  completedAt     DateTime?

  journey         ComplianceJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId])
  @@index([inputHash])
  @@map("compliance_automation_runs")
}

model ApplicationDossier {
  id                String                   @id @default(uuid()) @db.Uuid
  journeyId         String                   @db.Uuid
  productId         String                   @db.Uuid
  version           Int                      @default(1)
  status            ApplicationDossierStatus @default(DRAFT)
  title             String
  summary           String?                  @db.Text
  completenessScore Float                    @default(0)
  missingCount      Int                      @default(0)
  unverifiedCount   Int                      @default(0)
  verifiedCount     Int                      @default(0)
  validatedAt       DateTime?
  exportedAt        DateTime?
  metadata          Json?                    @default("{}")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  journey           ComplianceJourney        @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  product           Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  items             ApplicationDossierItem[]

  @@index([journeyId])
  @@index([productId])
  @@index([status])
  @@map("application_dossiers")
}

model ApplicationDossierItem {
  id                 String                     @id @default(uuid()) @db.Uuid
  dossierId          String                     @db.Uuid
  requirementId      String?                    @db.Uuid
  itemType           String
  title              String
  description        String?                    @db.Text
  sourceType         String                     @default("DOCUMENT")
  sourceEntityId     String?
  documentId         String?                    @db.Uuid
  verificationStatus DocumentVerificationStatus @default(UNVERIFIED)
  required           Boolean                    @default(true)
  status             DossierItemStatus          @default(MISSING)
  evidence           Json?
  itemOrder          Int                        @default(1)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  dossier            ApplicationDossier         @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  requirement        ComplianceRequirement?     @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  document           ProductDocument?           @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([dossierId])
  @@index([requirementId])
  @@index([documentId])
  @@index([status])
  @@map("application_dossier_items")
}

model RegulatoryChangeEvent {
  id                        String               @id @default(uuid()) @db.Uuid
  sourceDocumentId          String?              @db.Uuid
  changeType                RegulatoryChangeType @default(OTHER)
  title                     String
  summary                   String?              @db.Text
  affectedStandards         Json?                @default("[]")
  affectedProductCategories Json?                @default("[]")
  effectiveDate             DateTime?
  detectedAt                DateTime             @default(now())
  sourceUrl                 String?
  authorityLevel            AuthorityLevel       @default(AUTHORITATIVE)
  status                    String               @default("ACTIVE")
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  sourceDocument            SourceDocument?      @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  impacts                   RegulatoryImpact[]

  @@index([sourceDocumentId])
  @@index([changeType])
  @@index([status])
  @@map("regulatory_change_events")
}

model RegulatoryImpact {
  id                   String                @id @default(uuid()) @db.Uuid
  changeEventId        String                @db.Uuid
  productId            String                @db.Uuid
  journeyId            String?               @db.Uuid
  impactLevel          RegulatoryImpactLevel @default(NEEDS_REVIEW)
  affectedRequirements Json?                 @default("[]")
  requiredActions      Json?                 @default("[]")
  evidence             Json?                 @default("{}")
  status               String                @default("PENDING_REVIEW")
  createdAt            DateTime              @default(now())

  changeEvent          RegulatoryChangeEvent @relation(fields: [changeEventId], references: [id], onDelete: Cascade)
  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  journey              ComplianceJourney?    @relation(fields: [journeyId], references: [id], onDelete: SetNull)

  @@unique([changeEventId, productId])
  @@index([changeEventId])
  @@index([productId])
  @@index([journeyId])
  @@index([impactLevel])
  @@map("regulatory_impacts")
}

model ComplianceAlert {
  id                String              @id @default(uuid()) @db.Uuid
  productId         String              @db.Uuid
  journeyId         String?             @db.Uuid
  alertType         ComplianceAlertType @default(OTHER)
  priority          RequirementPriority @default(HIGH)
  title             String
  reason            String              @db.Text
  source            String?
  recommendedAction String?             @db.Text
  isRead            Boolean             @default(false)
  isResolved        Boolean             @default(false)
  readAt            DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  journey           ComplianceJourney?  @relation(fields: [journeyId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([journeyId])
  @@index([alertType])
  @@index([priority])
  @@index([isRead])
  @@index([isResolved])
  @@map("compliance_alerts")
}

