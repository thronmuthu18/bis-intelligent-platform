// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Users & Auth
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
  DATA_MANAGER
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  name             String
  passwordHash     String
  role             UserRole  @default(USER)
  organizationName String?
  isActive         Boolean   @default(true)
  emailVerified    Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime?

  // Relations — to be expanded in future phases
  products          Product[]
  documents         ProductDocument[]         @relation("DocumentUploadedByUser")
  verifiedDocuments ProductDocument[]         @relation("DocumentVerifiedByUser")
  auditLogs         AuditLog[]
  aiConversations   AiConversation[]
  laboratoryReviews ProductLaboratoryReview[]
  assignedComplianceTasks ComplianceTask[]
  hallmarkVerifications   HallmarkVerification[]
  consumerVerifications   ConsumerVerification[]
  preference              UserPreference?

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Products & Compliance Workflow
// ─────────────────────────────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  INFORMATION_COLLECTION
  READY_FOR_ANALYSIS
  ACTIVE
  ARCHIVED
}

enum ComplianceWorkflowStage {
  DRAFT
  PRODUCT_IDENTIFIED
  INFORMATION_COLLECTION
  DOCUMENT_COLLECTION
  ANALYSIS
  STANDARD_IDENTIFICATION
  CERTIFICATION_ANALYSIS
  TESTING_ANALYSIS
  LAB_SELECTION
  DOCUMENT_VERIFICATION
  READY_FOR_OFFICIAL_ACTION
  OFFICIAL_ACTION
  COMPLIANCE_TRACKING
}

model Product {
  id                     String                  @id @default(uuid()) @db.Uuid
  userId                 String                  @db.Uuid
  name                   String
  category               String
  description            String?
  manufacturerType       String?
  intendedUse            String?
  targetMarket           String?
  countryOfManufacture   String?
  manufacturerName       String?
  manufacturerAddress    String?
  manufacturingCountry   String?
  manufacturingState     String?
  hsnCode                String?
  productCategory        String?
  technicalSpecifications Json?
  status                 ProductStatus           @default(DRAFT)
  workflowStage          ComplianceWorkflowStage @default(DRAFT)
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  lastActivityAt         DateTime?

  user                          User                                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents                     ProductDocument[]
  documentCompletenessAnalyses  ProductDocumentCompletenessAnalysis[]
  aiConversations               AiConversation[]
  auditLogs                     AuditLog[]
  productAnswers                ProductAnswer[]
  attributes                    ProductAttribute[]
  standardAnalyses              ProductStandardAnalysis[]
  standardReviews               ProductStandardReview[]
  certificationAnalyses         ProductCertificationAnalysis[]
  schemeReviews                 ProductSchemeReview[]
  testingAnalyses               ProductTestingAnalysis[]
  laboratoryReviews             ProductLaboratoryReview[]
  complianceJourneys            ComplianceJourney[]
  applicationDossiers           ApplicationDossier[]
  regulatoryImpacts             RegulatoryImpact[]
  complianceAlerts              ComplianceAlert[]

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("products")
}

model ProductAnswer {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  question   String
  answer     String
  answeredAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_answers")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Phase 9 — Document Intelligence Models & Enums
// ─────────────────────────────────────────────────────────────────────────────

enum DocumentType {
  TEST_REPORT
  CALIBRATION_CERTIFICATE
  PRODUCT_MANUAL
  TECHNICAL_SPECIFICATION
  FACTORY_LAYOUT
  MANUFACTURING_PROCESS_DOCUMENT
  QUALITY_CONTROL_DOCUMENT
  RAW_MATERIAL_DOCUMENT
  CERTIFICATE
  APPLICATION_DOCUMENT
  DECLARATION
  DECLARATION_OF_CONFORMITY
  LABORATORY_DOCUMENT
  IDENTITY_DOCUMENT
  FACTORY_INSPECTION_REPORT
  SAFETY_DATA_SHEET
  LICENSE
  GOVERNMENT_NOTIFICATION
  STANDARDS_DOCUMENT
  OTHER
  UNKNOWN
}

enum DocumentProcessingStatus {
  UPLOADED
  VALIDATING
  STORED
  EXTRACTING
  EXTRACTED
  CLASSIFYING
  CLASSIFIED
  ANALYZING
  ANALYZED
  NEEDS_REVIEW
  VERIFIED
  FAILED
}

enum DocumentVerificationStatus {
  UNVERIFIED
  NEEDS_REVIEW
  VERIFIED
  REJECTED
}

enum DocumentCompletenessStatus {
  COMPLETE
  PARTIALLY_COMPLETE
  MISSING_DOCUMENTS
  NEEDS_REVIEW
  INSUFFICIENT_EVIDENCE
}

enum ChecklistMatchStatus {
  MISSING
  UPLOADED
  EXTRACTED
  MATCHED
  NEEDS_REVIEW
  VERIFIED
  EXPIRED
  INVALID
}

enum TestRequirementMatchStatus {
  MATCHED
  PARTIAL_MATCH
  NEEDS_REVIEW
  NOT_MATCHED
  UNVERIFIED
}

model ProductDocument {
  id                       String                     @id @default(uuid()) @db.Uuid
  productId                String                     @db.Uuid
  uploadedByUserId         String                     @db.Uuid
  originalFileName         String
  storedFileName           String
  storageKey               String
  mimeType                 String
  fileSize                 Int
  fileHash                 String?
  documentType             DocumentType               @default(UNKNOWN)
  classificationConfidence Float?
  classificationReasons    Json?
  processingStatus         DocumentProcessingStatus   @default(UPLOADED)
  extractionStatus         String?                    @default("PENDING")
  verificationStatus       DocumentVerificationStatus @default(UNVERIFIED)
  pageCount                Int                        @default(1)
  extractedText            String?                    @db.Text
  extractionMetadata       Json?
  version                  Int                        @default(1)
  documentFamily           String?
  supersedesDocumentId     String?                    @db.Uuid
  isCurrent                Boolean                    @default(true)
  verifiedByUserId         String?                    @db.Uuid
  verifiedAt               DateTime?
  verificationNotes        String?                    @db.Text
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  processedAt              DateTime?

  product              Product                         @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploadedByUser       User                            @relation("DocumentUploadedByUser", fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  verifiedByUser       User?                           @relation("DocumentVerifiedByUser", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  supersedesDocument   ProductDocument?                @relation("DocumentVersions", fields: [supersedesDocumentId], references: [id], onDelete: SetNull)
  supersededBy         ProductDocument[]               @relation("DocumentVersions")
  pageEvidence         DocumentPageEvidence[]
  structuredExtraction DocumentStructuredExtraction?
  checklistMatches     DocumentChecklistMatch[]
  testMatches          DocumentTestMatch[]
  dossierItems         ApplicationDossierItem[]

  @@index([productId])
  @@index([uploadedByUserId])
  @@index([documentType])
  @@index([processingStatus])
  @@index([verificationStatus])
  @@index([fileHash])
  @@index([documentFamily])
  @@map("product_documents")
}

model DocumentPageEvidence {
  id          String   @id @default(uuid()) @db.Uuid
  documentId  String   @db.Uuid
  pageNumber  Int      @default(1)
  claim       String
  sourceText  String   @db.Text
  confidence  Float?
  boundingBox Json?
  sectionKey  String?
  createdAt   DateTime @default(now())

  document ProductDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([pageNumber])
  @@map("document_page_evidence")
}

model DocumentStructuredExtraction {
  id                  String       @id @default(uuid()) @db.Uuid
  documentId          String       @unique @db.Uuid
  extractedType       DocumentType @default(UNKNOWN)
  laboratoryName      String?
  reportNumber        String?
  reportDate          DateTime?
  certificateNumber   String?
  calibrationDate     DateTime?
  calibrationDueDate  DateTime?
  calibrationInterval String?
  traceability        String?
  productName         String?
  modelNumber         String?
  manufacturerName    String?
  standardNumber      String?
  passFailStatus      String?
  validityStatus      String?
  extractedFields     Json         @default("{}")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  document ProductDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_structured_extractions")
}

model DocumentChecklistMatch {
  id                String               @id @default(uuid()) @db.Uuid
  documentId        String               @db.Uuid
  checklistItemId   String?              @db.Uuid
  checklistCategory String?
  requirementTitle  String?
  matchStatus       ChecklistMatchStatus @default(MATCHED)
  confidence        Float?
  matchReason       String?              @db.Text
  evidencePage      Int?
  evidenceSnippet   String?              @db.Text
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  document      ProductDocument                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  checklistItem ProductDocumentationChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([checklistItemId])
  @@map("document_checklist_matches")
}

model DocumentTestMatch {
  id                String                     @id @default(uuid()) @db.Uuid
  documentId        String                     @db.Uuid
  testRequirementId String?                    @db.Uuid
  testName          String
  testMethod        String?
  standardNumber    String?
  parameter         String?
  extractedResult   String?
  passFailStatus    String?
  matchStatus       TestRequirementMatchStatus @default(MATCHED)
  evidencePage      Int?
  evidenceSnippet   String?                    @db.Text
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  document        ProductDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  testRequirement ProductTestRequirement? @relation(fields: [testRequirementId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([testRequirementId])
  @@map("document_test_matches")
}

model ProductDocumentCompletenessAnalysis {
  id                   String                     @id @default(uuid()) @db.Uuid
  productId            String                     @db.Uuid
  score                Int                        @default(0)
  status               DocumentCompletenessStatus @default(INSUFFICIENT_EVIDENCE)
  totalRequired        Int                        @default(0)
  verifiedCount        Int                        @default(0)
  matchedCount         Int                        @default(0)
  needsReviewCount     Int                        @default(0)
  missingCount         Int                        @default(0)
  expiredCount         Int                        @default(0)
  missingDocumentTypes Json                       @default("[]")
  blockers             Json                       @default("[]")
  nextSteps            Json                       @default("[]")
  calculatedAt         DateTime                   @default(now())
  createdAt            DateTime                   @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_document_completeness_analyses")
}

// ─────────────────────────────────────────────────────────────────────────────
//  BIS Knowledge Layer Enums (Phase 4)
// ─────────────────────────────────────────────────────────────────────────────

enum SourceType {
  BIS_OFFICIAL
  GOVERNMENT_GAZETTE
  BIS_DOCUMENT
  OTHER_REFERENCE
}

enum AuthorityLevel {
  AUTHORITATIVE
  REFERENCE
  UNVERIFIED
}

enum IngestionStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum StandardStatus {
  CURRENT
  SUPERSEDED
  WITHDRAWN
  DRAFT
  UNKNOWN
}

// ─────────────────────────────────────────────────────────────────────────────
//  Source Documents & Provenance Registry
// ─────────────────────────────────────────────────────────────────────────────

model SourceDocument {
  id             String         @id @default(uuid()) @db.Uuid
  title          String
  url            String
  sourceType     SourceType     @default(BIS_OFFICIAL)
  authorityLevel AuthorityLevel @default(AUTHORITATIVE)
  documentType   String?
  publishedAt    DateTime?
  retrievedAt    DateTime       @default(now())
  contentHash    String?
  versionLabel   String?
  status         String         @default("ACTIVE")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  standards              Standard[]
  standardVersions       StandardVersion[]
  standardAmendments     StandardAmendment[]
  qcos                   QCO[]
  schemes                Scheme[]
  productManuals         ProductManual[]
  standardSchemeMappings StandardSchemeMapping[]
  knowledgeChunks        KnowledgeChunk[]
  laboratories           Laboratory[]
  laboratoryCapabilities LaboratoryCapability[]
  testRequirements       ProductTestRequirement[]
  regulatoryChangeEvents RegulatoryChangeEvent[]
  complianceRequirements ComplianceRequirement[]
  hallmarkingCentres     HallmarkingCentre[]
  hallmarkVerifications  HallmarkVerification[]
  consumerServices       ConsumerService[]

  @@index([url])
  @@index([sourceType])
  @@index([authorityLevel])
  @@map("source_documents")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Indian Standards (IS) Knowledge Base
// ─────────────────────────────────────────────────────────────────────────────

model Standard {
  id               String         @id @default(uuid()) @db.Uuid
  isNumber         String         @unique
  canonicalNumber  String
  title            String
  shortTitle       String?
  scope            String?        @db.Text
  status           StandardStatus @default(CURRENT)
  sector           String?
  department       String?
  language         String         @default("English")
  currentEdition   String?
  publicationDate  DateTime?
  withdrawalDate   DateTime?
  sourceDocumentId String?        @db.Uuid
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  sourceDocument       SourceDocument?         @relation(fields: [sourceDocumentId], references: [id])
  versions             StandardVersion[]
  amendments           StandardAmendment[]
  qcoMappings          QCOStandardMapping[]
  schemeMappings       StandardSchemeMapping[]
  productManuals       ProductManual[]
  citations            Citation[]
  certificationSchemes CertificationScheme[]
  knowledgeChunks      KnowledgeChunk[]
  productMatches         ProductStandardMatch[]
  productReviews         ProductStandardReview[]
  schemeRecommendations  ProductSchemeRecommendation[]
  qcoInformationItems    ProductQcoInformationItem[]
  testRequirements       ProductTestRequirement[]
  laboratoryCapabilities LaboratoryCapability[]
  complianceRequirements ComplianceRequirement[]

  @@index([isNumber])
  @@index([canonicalNumber])
  @@index([status])
  @@index([sector])
  @@index([department])
  @@map("standards")
}

model StandardVersion {
  id               String          @id @default(uuid()) @db.Uuid
  standardId       String          @db.Uuid
  edition          String
  year             Int?
  publicationDate  DateTime?
  status           StandardStatus  @default(CURRENT)
  documentUrl      String?
  sourceDocumentId String?         @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  standard        Standard         @relation(fields: [standardId], references: [id], onDelete: Cascade)
  sourceDocument  SourceDocument?  @relation(fields: [sourceDocumentId], references: [id])
  knowledgeChunks KnowledgeChunk[]

  @@index([standardId])
  @@map("standard_versions")
}

model StandardAmendment {
  id               String          @id @default(uuid()) @db.Uuid
  standardId       String          @db.Uuid
  amendmentNumber  String
  title            String?
  publicationDate  DateTime?
  effectiveDate    DateTime?
  documentUrl      String?
  sourceDocumentId String?         @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  standard        Standard         @relation(fields: [standardId], references: [id], onDelete: Cascade)
  sourceDocument  SourceDocument?  @relation(fields: [sourceDocumentId], references: [id])
  knowledgeChunks KnowledgeChunk[]

  @@index([standardId])
  @@map("standard_amendments")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Quality Control Orders (QCOs)
// ─────────────────────────────────────────────────────────────────────────────

model QCO {
  id               String          @id @default(uuid()) @db.Uuid
  name             String
  orderNumber      String          @unique
  ministry         String?
  notificationDate DateTime?
  effectiveDate    DateTime?
  status           String          @default("IN_FORCE")
  documentUrl      String?
  sourceDocumentId String?         @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  sourceDocument   SourceDocument?      @relation(fields: [sourceDocumentId], references: [id])
  standardMappings QCOStandardMapping[]
  knowledgeChunks  KnowledgeChunk[]
  qcoInformationItems ProductQcoInformationItem[]

  @@index([orderNumber])
  @@index([effectiveDate])
  @@index([status])
  @@map("qcos")
}

model QCOStandardMapping {
  id                 String   @id @default(uuid()) @db.Uuid
  qcoId              String   @db.Uuid
  standardId         String   @db.Uuid
  productDescription String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  qco      QCO      @relation(fields: [qcoId], references: [id], onDelete: Cascade)
  standard Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@unique([qcoId, standardId])
  @@index([qcoId])
  @@index([standardId])
  @@map("qco_standard_mappings")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Certification Schemes & Product Manuals
// ─────────────────────────────────────────────────────────────────────────────

model Scheme {
  id               String          @id @default(uuid()) @db.Uuid
  name             String
  code             String          @unique
  description      String?         @db.Text
  sourceDocumentId String?         @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  sourceDocument   SourceDocument?         @relation(fields: [sourceDocumentId], references: [id])
  standardMappings StandardSchemeMapping[]
  knowledgeChunks  KnowledgeChunk[]
  schemeRecommendations   ProductSchemeRecommendation[]
  schemeReviews           ProductSchemeReview[]
  feeEstimates            CertificationFeeEstimate[]
  documentationChecklists ProductDocumentationChecklistItem[]
  applicationRequirements ProductApplicationRequirementItem[]
  testRequirements        ProductTestRequirement[]
  externalLabRequirements ProductExternalLabRequirement[]

  @@index([code])
  @@map("schemes")
}

model StandardSchemeMapping {
  id               String          @id @default(uuid()) @db.Uuid
  standardId       String          @db.Uuid
  schemeId         String          @db.Uuid
  sourceDocumentId String?         @db.Uuid
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  standard       Standard        @relation(fields: [standardId], references: [id], onDelete: Cascade)
  scheme         Scheme          @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id])

  @@unique([standardId, schemeId])
  @@index([standardId])
  @@index([schemeId])
  @@map("standard_scheme_mappings")
}

model ProductManual {
  id               String          @id @default(uuid()) @db.Uuid
  standardId       String          @db.Uuid
  title            String
  documentUrl      String?
  version          String?
  publicationDate  DateTime?
  sourceDocumentId String?         @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  standard        Standard         @relation(fields: [standardId], references: [id], onDelete: Cascade)
  sourceDocument  SourceDocument?  @relation(fields: [sourceDocumentId], references: [id])
  knowledgeChunks KnowledgeChunk[]

  @@index([standardId])
  @@map("product_manuals")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Knowledge Chunks & Vector Store (Phase 5)
// ─────────────────────────────────────────────────────────────────────────────

model KnowledgeChunk {
  id                  String          @id @default(uuid()) @db.Uuid
  sourceDocumentId    String?         @db.Uuid
  standardId          String?         @db.Uuid
  standardVersionId   String?         @db.Uuid
  standardAmendmentId String?         @db.Uuid
  qcoId               String?         @db.Uuid
  schemeId            String?         @db.Uuid
  productManualId     String?         @db.Uuid
  chunkType           String
  sectionTitle        String?
  content             String          @db.Text
  chunkIndex          Int             @default(0)
  embedding           Float[]
  embeddingModel      String?
  embeddingDimension  Int?
  embeddingVersion    String?
  contentHash         String?
  embeddingStatus     IngestionStatus @default(PENDING)
  metadata            Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  sourceDocument    SourceDocument?    @relation(fields: [sourceDocumentId], references: [id])
  standard          Standard?          @relation(fields: [standardId], references: [id], onDelete: Cascade)
  standardVersion   StandardVersion?   @relation(fields: [standardVersionId], references: [id], onDelete: Cascade)
  standardAmendment StandardAmendment? @relation(fields: [standardAmendmentId], references: [id], onDelete: Cascade)
  qco               QCO?               @relation(fields: [qcoId], references: [id], onDelete: Cascade)
  scheme            Scheme?            @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  productManual     ProductManual?     @relation(fields: [productManualId], references: [id], onDelete: Cascade)

  @@index([standardId])
  @@index([chunkType])
  @@index([embeddingStatus])
  @@index([contentHash])
  @@map("knowledge_chunks")
}

model IngestionRun {
  id               String          @id @default(uuid()) @db.Uuid
  sourceName       String
  sourceUrl        String?
  startedAt        DateTime        @default(now())
  completedAt      DateTime?
  status           IngestionStatus @default(PENDING)
  recordsProcessed Int             @default(0)
  recordsCreated   Int             @default(0)
  recordsUpdated   Int             @default(0)
  recordsSkipped   Int             @default(0)
  recordsFailed    Int             @default(0)
  errorSummary     String?         @db.Text
  triggeredBy      String?
  createdAt        DateTime        @default(now())

  @@index([status])
  @@index([startedAt])
  @@map("ingestion_runs")
}

model CertificationScheme {
  id          String   @id @default(uuid()) @db.Uuid
  standardId  String   @db.Uuid
  name        String
  schemeCode  String?
  description String?
  bisUrl      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  standard Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@index([standardId])
  @@map("certification_schemes")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Testing & Laboratories
// ─────────────────────────────────────────────────────────────────────────────

model Laboratory {
  id               String              @id @default(uuid()) @db.Uuid
  name             String
  code             String?
  organizationType LabOrganizationType @default(BIS_RECOGNIZED)
  address          String?
  city             String?
  state            String?
  country          String              @default("India")
  pincode          String?
  phone            String?
  email            String?
  website          String?
  isNabl           Boolean             @default(false)
  isBisLab         Boolean             @default(false)
  status           String              @default("ACTIVE")
  sourceDocumentId String?             @db.Uuid
  sourceUrl        String?
  authorityLevel   AuthorityLevel      @default(AUTHORITATIVE)
  isVerified       Boolean             @default(true)
  isActive         Boolean             @default(true)
  lastVerifiedAt   DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  sourceDocument SourceDocument?           @relation(fields: [sourceDocumentId], references: [id])
  capabilities   LaboratoryCapability[]
  reviews        ProductLaboratoryReview[]

  @@index([city])
  @@index([state])
  @@index([status])
  @@index([organizationType])
  @@map("laboratories")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Citations / Evidence (source provenance for AI findings)
// ─────────────────────────────────────────────────────────────────────────────

model Citation {
  id              String   @id @default(uuid()) @db.Uuid
  standardId      String?  @db.Uuid
  sourceUrl       String
  sourceTitle     String
  authority       String
  documentType    String
  publicationDate DateTime?
  revisionDate    DateTime?
  retrievedAt     DateTime
  relevantSection String?
  relevantClause  String?
  excerpt         String?
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())

  standard Standard? @relation(fields: [standardId], references: [id])

  @@index([standardId])
  @@map("citations")
}

// ─────────────────────────────────────────────────────────────────────────────
//  AI Conversations
// ─────────────────────────────────────────────────────────────────────────────

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model AiConversation {
  id        String   @id @default(uuid()) @db.Uuid
  productId String?  @db.Uuid
  userId    String   @db.Uuid
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product  Product?    @relation(fields: [productId], references: [id])
  user     User        @relation(fields: [userId], references: [id])
  messages AiMessage[]

  @@index([productId])
