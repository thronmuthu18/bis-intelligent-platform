  prerequisiteRequirement    ComplianceRequirement @relation("PrerequisiteRequirements", fields: [prerequisiteRequirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, prerequisiteRequirementId])
  @@index([requirementId])
  @@index([prerequisiteRequirementId])
  @@map("compliance_requirement_dependencies")
}

